<UserControl x:Class="VisualLog.Desktop.Dashboard.OpenedLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VisualLog.Desktop.Dashboard"
             xmlns:logmgr="clr-namespace:VisualLog.Desktop.LogManager"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="400">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate DataType="{x:Type logmgr:LogViewModel}">
        <local:OpenedLogView/>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="Opened" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="{Binding MainViewModel.Logs.Count, StringFormat='  ·  {0}'}"
                   Style="{StaticResource SecondaryText}"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding MainViewModel.Logs}"
                    Focusable="False"/>
    </DockPanel>
  </Border>
</UserControl>
