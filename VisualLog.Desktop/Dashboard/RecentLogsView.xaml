<UserControl x:Class="VisualLog.Desktop.Dashboard.RecentLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VisualLog.Desktop.Dashboard"
             xmlns:conv="clr-namespace:VisualLog.Desktop"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700"
             Loaded="UserControl_Loaded">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate DataType="{x:Type local:RecentLogViewModel}">
        <local:RecentLogView/>
      </DataTemplate>
      <conv:VisibilityCountConverter x:Key="VisibleIfAny"/>
      <conv:VisibilityCountConverter x:Key="VisibleIfNone" Reverse="True"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}">
    <DockPanel>

      <!-- HEADER -->
      <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Recent" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="{Binding RecentLogs.Count, StringFormat='  ·  {0}'}"
                     Style="{StaticResource SecondaryText}"
                     VerticalAlignment="Center"
                     Visibility="{Binding RecentLogs.Count, Converter={StaticResource VisibleIfAny}}"/>
        </StackPanel>
        <Button Grid.Column="1"
                Content="Clear list"
                Style="{StaticResource SubtleButton}"
                Command="{Binding ClearCommand}"
                Visibility="{Binding RecentLogs.Count, Converter={StaticResource VisibleIfAny}}"/>
      </Grid>

      <!-- EMPTY STATE -->
      <StackPanel DockPanel.Dock="Top"
                  Margin="0,24,0,28"
                  HorizontalAlignment="Center"
                  Visibility="{Binding RecentLogs.Count, Converter={StaticResource VisibleIfNone}}">
        <TextBlock Text="&#xE823;"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="28"
                   Foreground="{StaticResource TextTertiaryBrush}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="No recent logs yet"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,10,0,2"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Files you open will appear here for quick access."
                   Style="{StaticResource SecondaryText}"
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- LOGS -->
      <ItemsControl ItemsSource="{Binding RecentLogs}"
                    Focusable="False"
                    KeyboardNavigation.TabNavigation="Continue"/>
    </DockPanel>
  </Border>
</UserControl>
