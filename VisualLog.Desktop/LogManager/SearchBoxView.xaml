<UserControl x:Class="VisualLog.Desktop.LogManager.SearchBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:root="clr-namespace:VisualLog.Desktop"
             xmlns:logmgr="clr-namespace:VisualLog.Desktop.LogManager"
             mc:Ignorable="d"
             d:DesignHeight="34" d:DesignWidth="560"
             d:DataContext="{d:DesignInstance Type=logmgr:SearchViewModel}">
  <!-- Query box of the log toolbar, everything inside one frame:
       [🔍 query          3 / 97  ↑ ↓ ☰  ✕ | .* Aa ▾]
       The result controls appear only while there is a query. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <root:VisibilityBoolConverter x:Key="VisibilityBoolConverter"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal" TextBlock.FontFamily="{StaticResource UiFont}">

    <Border x:Name="Frame"
            Width="460"
            Style="{StaticResource SearchBoxFrame}"
            Tag="{Binding HasRegexError}"
            ToolTip="{Binding RegexError}"
            ToolTipService.IsEnabled="{Binding HasRegexError}">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Left"
                   Text="&#xE721;"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="13"
                   Margin="2,0,6,0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center"/>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

          <!-- Results of the current query -->
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding HasQuery, Converter={StaticResource VisibilityBoolConverter}}">
            <TextBlock Text="{Binding PositionText}"
                       Margin="6,0,4,0"
                       VerticalAlignment="Center"
                       FontSize="12">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="NoMatches">
                      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Button Style="{StaticResource SmallIconButton}" Content="&#xE70E;" FontSize="11" ToolTip="Previous match (Shift+F3)" Command="{Binding PreviousCommand}"/>
            <Button Style="{StaticResource SmallIconButton}" Content="&#xE70D;" FontSize="11" ToolTip="Next match (F3)" Command="{Binding NextCommand}"/>
            <ToggleButton Style="{StaticResource SearchOptionToggle}"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="12"
                          Content="&#xE8FD;"
                          ToolTip="Results panel"
                          IsChecked="{Binding LogViewModel.State.ShowSearchPanel}"/>
            <Button Style="{StaticResource SmallIconButton}"
                    Content="&#xE711;"
                    FontSize="10"
                    ToolTip="Clear (Esc closes the panel)"
                    Command="{Binding ClearCommand}"/>
            <Border Width="1" Height="16" Margin="3,0,3,0" Background="{StaticResource CardBorderBrush}"/>
          </StackPanel>

          <!-- Options of the query -->
          <ToggleButton Style="{StaticResource SearchOptionToggle}"
                        Content=".*"
                        IsChecked="{Binding UseRegex}"
                        ToolTip="Use regular expression (Alt+R)"/>
          <ToggleButton Style="{StaticResource SearchOptionToggle}"
                        Content="Aa"
                        IsChecked="{Binding MatchCase}"
                        ToolTip="Match case (Alt+C)"/>
          <ToggleButton x:Name="HistoryToggle"
                        Content="&#xE81C;"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="12"
                        ToolTip="Recent searches (Alt+Down)">
            <ToggleButton.Style>
              <!-- A click on the toggle while open only closes the popup (StaysOpen=False), not reopens it -->
              <Style TargetType="ToggleButton" BasedOn="{StaticResource SearchOptionToggle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsOpen, ElementName=HistoryPopup}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ToggleButton.Style>
          </ToggleButton>
        </StackPanel>

        <TextBox x:Name="QueryTextBox"
                 Style="{StaticResource SearchBoxTextBox}"
                 Tag="Search in log (Ctrl+F)"
                 Text="{Binding StringToSearch, UpdateSourceTrigger=PropertyChanged}">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
            <KeyBinding Key="Enter" Modifiers="Shift" Command="{Binding SearchCommand}" CommandParameter="back"/>
          </TextBox.InputBindings>
        </TextBox>
      </DockPanel>
    </Border>

    <Popup x:Name="HistoryPopup"
           PlacementTarget="{Binding ElementName=Frame}"
           Placement="Bottom"
           VerticalOffset="4"
           StaysOpen="False"
           AllowsTransparency="True"
           IsOpen="{Binding IsChecked, ElementName=HistoryToggle}">
      <Border Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource CardBorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="4"
              Width="{Binding ActualWidth, ElementName=Frame}"
              Margin="0,0,8,8">
        <Border.Effect>
          <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
          <TextBlock Text="No recent searches"
                     Margin="8,6"
                     Foreground="{StaticResource TextTertiaryBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding History.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ItemsControl ItemsSource="{Binding History}" MaxHeight="320">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource SubtleButton}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        HorizontalContentAlignment="Stretch"
                        Click="HistoryItem_Click"
                        Command="{Binding DataContext.UseHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE81C;" Style="{StaticResource PanelActionGlyph}" Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Popup>

    <!-- Separates the search from the other toolbar buttons -->
    <Border Width="1" Height="20" Margin="12,0,8,0" Background="{StaticResource CardBorderBrush}"/>
  </StackPanel>
</UserControl>
