<UserControl x:Class="VisualLog.Desktop.LogManager.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:root="clr-namespace:VisualLog.Desktop"
             xmlns:logmgr="clr-namespace:VisualLog.Desktop.LogManager"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=logmgr:SearchViewModel}">
  <!-- Search results panel under the log -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <root:VisibilityBoolConverter x:Key="VisibilityBoolConverter"/>
      <root:VisibilityBoolConverter x:Key="VisibilityBoolConverterReverse" Reverse="True"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Gesture="Esc" Command="{Binding HideSearchPanelCommand}"/>
  </UserControl.InputBindings>

  <Grid Background="{StaticResource CardBrush}" TextBlock.FontFamily="{StaticResource UiFont}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header: summary, live, actions on all results, close -->
    <Border Grid.Row="0"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,4,6,4">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource PanelActionButton}" Command="{Binding CopyAllCommand}" ToolTip="Copy all found lines to the clipboard">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8C8;" Style="{StaticResource PanelActionGlyph}"/>
              <TextBlock Text="Copy all"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PanelActionButton}" Command="{Binding ExportCommand}" ToolTip="Save all found lines to a file">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" Style="{StaticResource PanelActionGlyph}"/>
              <TextBlock Text="Export…"/>
            </StackPanel>
          </Button>
          <Border Width="1" Height="18" Margin="6,0,4,0" Background="{StaticResource CardBorderBrush}"/>
          <Button Style="{StaticResource SmallIconButton}"
                  Content="&#xE74D;"
                  ToolTip="Clear search"
                  Command="{Binding ClearCommand}"/>
          <Button Style="{StaticResource SmallIconButton}"
                  Content="&#xE711;"
                  FontSize="10"
                  ToolTip="Close panel (Esc)"
                  Command="{Binding HideSearchPanelCommand}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding SummaryText}" FontSize="12.5" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="InvalidRegex">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Status}" Value="NoMatches">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ToggleButton Margin="12,0,0,0"
                        Padding="8,3,10,3"
                        IsChecked="{Binding IsLive}"
                        ToolTip="Search new lines of the log as they arrive">
            <ToggleButton.Style>
              <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolbarToggleButton}">
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Style.Triggers>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource LiveBrush}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ToggleButton.Style>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
              <TextBlock Text="Live" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Found lines -->
    <ListView x:Name="SearchEntriesList"
              Grid.Row="1"
              Grid.IsSharedSizeScope="True"
              ItemsSource="{Binding SearchEntries}"
              SelectedItem="{Binding CurrentEntry, Mode=TwoWay}"
              SelectionMode="Extended"
              BorderThickness="0"
              Background="Transparent"
              ItemContainerStyle="{StaticResource SearchResultItem}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              SelectionChanged="SearchEntriesList_SelectionChanged"
              MouseDoubleClick="SearchEntriesList_MouseDoubleClick"
              Visibility="{Binding HasResults, Converter={StaticResource VisibilityBoolConverter}}">
      <ListView.InputBindings>
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopySelectedCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopySelectedWithLineNumbersCommand}"/>
        <KeyBinding Key="Enter" Command="{Binding GoToEntryCommand}" CommandParameter="{Binding CurrentEntry}"/>
      </ListView.InputBindings>
      <ListView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Go to line" InputGestureText="Enter"
                    Command="{Binding GoToEntryCommand}" CommandParameter="{Binding CurrentEntry}"/>
          <Separator/>
          <MenuItem Header="Copy selected" InputGestureText="Ctrl+C" Command="{Binding CopySelectedCommand}"/>
          <MenuItem Header="Copy selected with line numbers" InputGestureText="Ctrl+Shift+C" Command="{Binding CopySelectedWithLineNumbersCommand}"/>
          <Separator/>
          <MenuItem Header="Copy all" Command="{Binding CopyAllCommand}"/>
          <MenuItem Header="Export all…" Command="{Binding ExportCommand}"/>
        </ContextMenu>
      </ListView.ContextMenu>
      <ListView.ItemTemplate>
        <DataTemplate DataType="{x:Type logmgr:SearchEntryViewModel}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="LineNumber"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding SearchEntry.LineNumber}"
                       FontFamily="{StaticResource LogFont}"
                       FontSize="{StaticResource LogFontSize}"
                       TextOptions.TextFormattingMode="Display"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       TextAlignment="Right"
                       MinWidth="40"
                       Margin="12,0,12,0"
                       VerticalAlignment="Center"/>
            <logmgr:SearchEntryView Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Empty states -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="16"
                Visibility="{Binding HasResults, Converter={StaticResource VisibilityBoolConverterReverse}}">
      <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="22" Margin="0,0,0,8">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE721;"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Status}" Value="InvalidRegex">
                <Setter Property="Text" Value="&#xE783;"/>
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Text" Value="Type to search in this log"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Status}" Value="Searching">
                <Setter Property="Text" Value="Searching…"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="NoMatches">
                <Setter Property="Text" Value="No lines match the search"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="InvalidRegex">
                <Setter Property="Text" Value="The regular expression is invalid"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{Binding RegexError}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="600"
                 Margin="0,6,0,0"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="11.5"
                 Foreground="{StaticResource ErrorBrush}"
                 Visibility="{Binding HasRegexError, Converter={StaticResource VisibilityBoolConverter}}"/>
    </StackPanel>
  </Grid>
</UserControl>
