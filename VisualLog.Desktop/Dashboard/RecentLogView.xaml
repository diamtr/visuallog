<UserControl x:Class="VisualLog.Desktop.Dashboard.RecentLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:VisualLog.Desktop"
             xmlns:convs="clr-namespace:VisualLog.Desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="56" d:DesignWidth="600" d:Background="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <conv:VisibilityBoolConverter x:Key="ShowOnHover"/>
      <conv:VisibilityBoolConverter x:Key="HideOnHover" Reverse="True"/>
      <convs:RelativeTimeConverter x:Key="RelativeTime"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <Button x:Name="Row"
          Style="{StaticResource ListRowButton}"
          Command="{Binding OpenCommand}"
          ToolTip="{Binding LogInfo.Path}"
          ToolTipService.InitialShowDelay="800">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- File icon -->
      <Border Grid.Column="0"
              Width="34" Height="34"
              CornerRadius="6"
              Background="{StaticResource AccentSubtleBrush}"
              Margin="0,0,12,0">
        <TextBlock Text="&#xE8A5;"
                   FontFamily="{StaticResource IconFont}"
                   FontSize="16"
                   Foreground="{StaticResource AccentBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>

      <!-- Name and folder -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding LogInfo.DisplayName, Mode=OneWay}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding LogInfo.PathDirectory, Mode=OneWay}"
                   Style="{StaticResource SecondaryText}"
                   Margin="0,1,0,0"/>
      </StackPanel>

      <!-- Time, replaced by actions on hover -->
      <Grid Grid.Column="2" MinWidth="110" Margin="12,0,0,0">
        <TextBlock Text="{Binding LogInfo.LastOpened, Mode=OneWay, Converter={StaticResource RelativeTime}}"
                   Style="{StaticResource SecondaryText}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsMouseOver, ElementName=Row, Converter={StaticResource HideOnHover}}"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Visibility="{Binding IsMouseOver, ElementName=Row, Converter={StaticResource ShowOnHover}}">
          <Button Style="{StaticResource IconButton}"
                  Content="&#xED25;"
                  ToolTip="Show in Explorer"
                  Command="{Binding ShowInExplorerCommand}"/>
          <Button Style="{StaticResource IconButton}"
                  Content="&#xE711;"
                  ToolTip="Remove from recent"
                  Command="{Binding RemoveCommand}"
                  Margin="2,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Button>
</UserControl>
