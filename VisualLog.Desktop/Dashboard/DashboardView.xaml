<UserControl x:Class="VisualLog.Desktop.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:VisualLog.Desktop.Dashboard"
             xmlns:search="clr-namespace:VisualLog.Desktop.Search"
             xmlns:conv="clr-namespace:VisualLog.Desktop"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200"
             FontFamily="{DynamicResource UiFont}"
             Foreground="{DynamicResource TextPrimaryBrush}">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate DataType="{x:Type search:SearchViewModel}">
        <search:SearchVew/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type local:OpenedLogsViewModel}">
        <local:OpenedLogsView/>
      </DataTemplate>
      <DataTemplate DataType="{x:Type local:RecentLogsViewModel}">
        <local:RecentLogsView/>
      </DataTemplate>
      <conv:VisibilityCountConverter x:Key="VisibleIfAny"/>
    </ResourceDictionary>
  </UserControl.Resources>

  <ScrollViewer Background="{StaticResource SurfaceBrush}"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="1280" Margin="40,32,40,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- PAGE HEADER -->
      <StackPanel Grid.Row="0" Margin="4,0,0,24">
        <TextBlock Text="VisualLog" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Open a log file or pick up where you left off."
                   FontSize="13"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0,4,0,0"/>
      </StackPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="3*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- RECENT -->
        <ContentControl Grid.Column="0"
                        VerticalAlignment="Top"
                        Focusable="False"
                        Content="{Binding RecentLogsViewModel}"/>

        <StackPanel Grid.Column="2">

          <!-- START -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Start" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>

              <Button Style="{StaticResource AccentButton}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Command="{Binding MainViewModel.OpenLogsCommand}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Grid.Column="1" Text="Open log file…" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Ctrl+O" Opacity="0.75" FontSize="12"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
              </Button>

              <!-- Drop zone: the whole window accepts files, this is just a hint -->
              <Grid Margin="0,12,0,0" Height="92">
                <Rectangle RadiusX="6" RadiusY="6"
                           Stroke="{StaticResource CardBorderBrush}"
                           StrokeThickness="1.5"
                           StrokeDashArray="4 3"
                           Fill="#FAFAFA"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="20"
                             Foreground="{StaticResource TextTertiaryBrush}"
                             HorizontalAlignment="Center"/>
                  <TextBlock Text="or drop log files anywhere in the window"
                             Style="{StaticResource SecondaryText}"
                             Margin="0,8,0,0"
                             HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- OPENED -->
          <ContentControl Margin="0,20,0,0"
                          Focusable="False"
                          Content="{Binding OpenedLogsViewModel}"
                          Visibility="{Binding MainViewModel.Logs.Count, Converter={StaticResource VisibleIfAny}}"/>
        </StackPanel>
      </Grid>

      <!-- SEARCH IN OPENED LOGS -->
      <Border Grid.Row="2"
              Style="{StaticResource Card}"
              Margin="0,20,0,0"
              Visibility="{Binding MainViewModel.Logs.Count, Converter={StaticResource VisibleIfAny}}">
        <StackPanel>
          <TextBlock Text="Search in opened logs" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
          <ContentControl Focusable="False" Content="{Binding SearchViewModel}"/>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
