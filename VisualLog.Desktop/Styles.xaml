<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:VisualLog.Desktop.Controls"
                    xmlns:conv="clr-namespace:VisualLog.Desktop.Converters">
  
  <SolidColorBrush x:Key="DefaultBorderBrush" Color="Black"/>
  <SolidColorBrush x:Key="DefaultBackgroundBrush" Color="#f2f2f2"/>
  <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#414141"/>
  <SolidColorBrush x:Key="ActiveButtonBackgroundBrush" Color="#282828"/>
  <SolidColorBrush x:Key="ForegroundBrush" Color="#e3e3e3"/>
  <SolidColorBrush x:Key="RedBrush" Color="#CA3E47"/>
  <SolidColorBrush x:Key="YellowBrush" Color="Yellow"/>

  <!-- ============ Modern (Fluent-like) palette ============ -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#EDEDED"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5F5F"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#115EA3"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#0C3B5E"/>
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EBF3FC"/>
  <SolidColorBrush x:Key="RowHoverBrush" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="RowPressedBrush" Color="#EBEBEB"/>
  <SolidColorBrush x:Key="SubtleHoverBrush" Color="#0F000000"/>
  <SolidColorBrush x:Key="SubtlePressedBrush" Color="#1A000000"/>
  <SolidColorBrush x:Key="LiveBrush" Color="#0E7A0D"/>
  <SolidColorBrush x:Key="LiveSubtleBrush" Color="#E7F4E4"/>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="20,16,20,16"/>
  </Style>

  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <Style x:Key="AccentButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="16,8,16,8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text button without chrome, e.g. "Clear" in a card header -->
  <Style x:Key="SubtleButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    <Setter Property="Padding" Value="8,4,8,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Square icon-only button; Content is a glyph of IconFont -->
  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A whole list row that is clickable (and reachable with Tab + Enter) -->
  <Style x:Key="ListRowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Padding" Value="10,8,8,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <Style x:Key="SelectedLinesMenuButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Margin" Value="0,0,0,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="Blue"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  
  <Style x:Key="ActionButton" TargetType="{x:Type Button}">
    <Setter Property="Padding" Value="15,0,15,0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource DefaultBackgroundBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ActiveButtonBackgroundBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ActionButtonBorder" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource ForegroundBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5"/>
  </Style>

  <Style x:Key="OptionToggleButton" TargetType="{x:Type ToggleButton}">
    <Setter Property="Margin" Value="10,5,10,5"/>
    <Setter Property="Padding" Value="3,3,3,3"/>
    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource DefaultBackgroundBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Foreground" Value="{StaticResource DefaultBackgroundBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{StaticResource YellowBrush}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ActiveButtonBackgroundBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PanelHeader1" TargetType="{x:Type TextBlock}">
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FontStretch" Value="SemiExpanded" />
    <Setter Property="Margin" Value="10, 0, 0, 0" />
  </Style>

  <Style x:Key="SpacedVerticalItemsContentControl" TargetType="ItemsControl">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ContentControl">
          <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SpacedVerticalItemsContentPresenter" TargetType="ItemsControl">
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ContentPresenter">
          <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AvoidSelectionListViewItem" TargetType="ListViewItem">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
      </Trigger>
      <Trigger Property="IsFocused" Value="True">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============ Opened logs: tab strip ============ -->
  <Style x:Key="LogTabStrip" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <!-- Tabs never wrap: they scroll horizontally (mouse wheel), the scrollbar is hidden -->
          <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        CanContentScroll="False"
                        Focusable="False"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}">
            <StackPanel Orientation="Horizontal">
              <ItemsPresenter/>
              <Button Style="{StaticResource IconButton}"
                      Content="&#xE710;"
                      ToolTip="Open log file (Ctrl+O)"
                      Command="{Binding MainViewModel.OpenLogsCommand}"
                      Margin="4,0,0,3"
                      VerticalAlignment="Center"/>
            </StackPanel>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LogTab" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="MaxWidth" Value="260"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ToolTip" Value="{Binding LogPath}"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="800"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Height="36" Margin="0,0,2,0">
            <!-- Inactive tab hover: a soft rounded pill -->
            <Border x:Name="HoverBg"
                    Margin="0,3,0,4"
                    CornerRadius="6"
                    Background="{StaticResource SubtleHoverBrush}"
                    Opacity="0"/>
            <!-- Active tab: white card connected to the log content below -->
            <Border x:Name="SelectedBg"
                    CornerRadius="8,8,0,0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1,1,1,0"
                    Visibility="Hidden"/>
            <ContentPresenter Margin="12,0,6,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.2"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectedBg" Property="Visibility" Value="Visible"/>
              <Setter TargetName="HoverBg" Property="Visibility" Value="Hidden"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
              <Setter Property="Panel.ZIndex" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Opened logs: toolbar ============ -->
  <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="10,5,12,5"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtleHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubtlePressedBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToolbarGlyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Encoding picker: looks like a toolbar button, the list is a floating card -->
  <conv:EncodingPartConverter x:Key="EncodingPart"/>

  <Style x:Key="ToolbarComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid Margin="4,1,4,1">
            <Border x:Name="Bd" CornerRadius="4" Background="Transparent" Padding="12,6,10,6">
              <ContentPresenter/>
            </Border>
            <!-- Accent pill of the current encoding, same idea as the navigation rail -->
            <Border x:Name="Pill"
                    Width="3" Height="16"
                    CornerRadius="1.5"
                    Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Visibility="Hidden"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
              <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToolbarComboBox" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="MaxDropDownHeight" Value="380"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ToolbarComboBoxItem}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Converter={StaticResource EncodingPart}, ConverterParameter=Name}"
                       FontSize="12.5"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Converter={StaticResource EncodingPart}, ConverterParameter=Details}"
                       FontSize="11"
                       Foreground="{StaticResource TextTertiaryBrush}"/>
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle"
                          Style="{StaticResource ToolbarToggleButton}"
                          Margin="0"
                          Focusable="False"
                          ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8D2;" Style="{StaticResource ToolbarGlyph}"/>
                <TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EncodingPart}}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="&#xE70D;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="9"
                           Margin="8,1,0,0"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>

            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   PlacementTarget="{Binding ElementName=Toggle}"
                   Placement="Bottom"
                   VerticalOffset="2"
                   HorizontalOffset="-8"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
              <!-- Margin leaves room for the shadow -->
              <Border Margin="8,0,8,12"
                      Width="300"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{StaticResource CardBrush}"
                      BorderBrush="{StaticResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="0,4,0,4">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.14"/>
                </Border.Effect>
                <ScrollViewer CanContentScroll="True"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Left navigation rail ============ -->
  <SolidColorBrush x:Key="RailForegroundBrush" Color="#C8C8C8"/>
  <SolidColorBrush x:Key="RailAccentBrush" Color="#4CC2FF"/>
  <SolidColorBrush x:Key="RailDividerBrush" Color="#33FFFFFF"/>

  <CubicEase x:Key="NavEase" EasingMode="EaseOut"/>

  <Style x:Key="NavButton" TargetType="{x:Type ctl:NavButton}">
    <Setter Property="Width" Value="56"/>
    <Setter Property="Height" Value="54"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Foreground" Value="{StaticResource RailForegroundBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="600"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctl:NavButton}">
          <Grid Background="Transparent">
            <!-- Backgrounds fade in/out instead of switching instantly -->
            <Border x:Name="HoverBg" CornerRadius="6" Background="#17FFFFFF" Opacity="0"/>
            <Border x:Name="SelectedBg" CornerRadius="6" Background="#24FFFFFF" Opacity="0"/>

            <!-- Accent pill of the selected item, grows from the center -->
            <Border Width="3" Height="18"
                    CornerRadius="1.5"
                    Background="{StaticResource RailAccentBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleY="0"/>
              </Border.RenderTransform>
            </Border>

            <StackPanel x:Name="ContentPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <ScaleTransform x:Name="ContentScale"/>
              </StackPanel.RenderTransform>

              <Grid HorizontalAlignment="Center">
                <TextBlock Text="{TemplateBinding Glyph}"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="18"
                           HorizontalAlignment="Center"/>
                <Border x:Name="Badge"
                        MinWidth="16" Height="16"
                        Padding="4,0"
                        CornerRadius="8"
                        Background="{StaticResource RailAccentBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-7,-14,0">
                  <TextBlock Text="{Binding BadgeCount, RelativeSource={RelativeSource TemplatedParent}}"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Foreground="#1B1B1B"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                </Border>
              </Grid>

              <TextBlock Text="{TemplateBinding Label}"
                         FontFamily="{StaticResource UiFont}"
                         FontSize="10.5"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="BadgeCount" Value="0">
              <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="White"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.12"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HoverBg" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.2"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="White"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelectedBg" Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.25" EasingFunction="{StaticResource NavEase}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SelectedBg" Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY"
                                     To="0" Duration="0:0:0.15"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>

            <!-- Subtle "press in" like Fluent buttons -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ContentPanel" Property="Opacity" Value="0.8"/>
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleX"
                                     To="0.92" Duration="0:0:0.08"/>
                    <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleY"
                                     To="0.92" Duration="0:0:0.08"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleX"
                                     To="1" Duration="0:0:0.15" EasingFunction="{StaticResource NavEase}"/>
                    <DoubleAnimation Storyboard.TargetName="ContentScale" Storyboard.TargetProperty="ScaleY"
                                     To="1" Duration="0:0:0.15" EasingFunction="{StaticResource NavEase}"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ContentPanel" Property="Opacity" Value="0.35"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Settings: form fields ============ -->
  <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="FieldBorderBrush" Color="#D1D1D1"/>

  <!-- Text box with rounded border, accent underline on focus; Tag is the placeholder -->
  <Style x:Key="FieldTextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
    <Setter Property="Padding" Value="8,5,8,5"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"/>
            <Border x:Name="Underline"
                    Height="2"
                    Margin="1,0,1,0"
                    CornerRadius="0,0,4,4"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource AccentBrush}"
                    Visibility="Hidden"/>
            <TextBlock x:Name="Placeholder"
                       Text="{TemplateBinding Tag}"
                       Margin="{TemplateBinding Padding}"
                       Padding="2,0,0,0"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- Hover is a style trigger (not a template one), so derived styles can override
         BorderBrush, e.g. the red border of an invalid value stays on hover -->
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="#B3B3B3"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Small square option toggle, e.g. "Aa", ".*", "B" -->
  <Style x:Key="OptionToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarToggleButton}">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,2,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
  </Style>

  <!-- ============ Color picker ============ -->
  <Style x:Key="ColorSwatchButton" TargetType="Button">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="#26000000"
                  BorderThickness="1"
                  CornerRadius="4"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- "No color": white swatch crossed out -->
  <ControlTemplate x:Key="NoColorSwatch">
    <Grid Width="18" Height="18">
      <Border Background="White" BorderBrush="#40000000" BorderThickness="1" CornerRadius="4"/>
      <Line X1="4" Y1="14" X2="14" Y2="4" Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.4"/>
    </Grid>
  </ControlTemplate>

  <Style TargetType="{x:Type ctl:ColorPicker}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctl:ColorPicker}">
          <Grid>
            <ToggleButton x:Name="Toggle"
                          Style="{StaticResource ToolbarToggleButton}"
                          Padding="6,4,6,4"
                          Margin="0"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <StackPanel Orientation="Horizontal">
                <Grid Width="18" Height="18">
                  <Control x:Name="NoneSwatch" Template="{StaticResource NoColorSwatch}" Focusable="False"/>
                  <Border x:Name="ColorSwatch"
                          Background="{TemplateBinding SelectedBrush}"
                          BorderBrush="#40000000"
                          BorderThickness="1"
                          CornerRadius="4"
                          Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="LabelText"
                           Text="{TemplateBinding Label}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="&#xE70D;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="8"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="6,1,0,0"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </ToggleButton>

            <Popup x:Name="Popup"
                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                   PlacementTarget="{Binding ElementName=Toggle}"
                   Placement="Bottom"
                   VerticalOffset="2"
                   HorizontalOffset="-8"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
              <!-- Margin leaves room for the shadow -->
              <Border Margin="8,0,8,12"
                      DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                      Background="{StaticResource CardBrush}"
                      BorderBrush="{StaticResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="10">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.14"/>
                </Border.Effect>
                <StackPanel Width="168" TextElement.FontFamily="{StaticResource UiFont}">
                  <TextBlock Text="{Binding Label}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Margin="2,0,0,6"/>
                  <ItemsControl x:Name="Presets" ItemsSource="{Binding Colors}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource ColorSwatchButton}"
                                Background="{Binding Brush}"
                                ToolTip="{Binding Hex}"
                                Command="{Binding DataContext.SelectColorCommand, ElementName=Presets}"
                                CommandParameter="{Binding Hex}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Style="{StaticResource SubtleButton}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          HorizontalAlignment="Stretch"
                          Margin="0,6,0,0"
                          Padding="2,4,6,4"
                          Command="{Binding SelectColorCommand}">
                    <StackPanel Orientation="Horizontal">
                      <Control Template="{StaticResource NoColorSwatch}" Focusable="False"/>
                      <TextBlock Text="None" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <TextBox Style="{StaticResource FieldTextBox}"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Padding="6,3,6,3"
                           Tag="#RRGGBB"
                           ToolTip="Custom color: #RRGGBB or #AARRGGBB"
                           Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasColor" Value="True">
              <Setter TargetName="ColorSwatch" Property="Visibility" Value="Visible"/>
              <Setter TargetName="NoneSwatch" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Label" Value="">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="Label" Value="{x:Null}">
              <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <!-- A click on the swatch while open only closes the popup (StaysOpen=False), not reopens it -->
            <Trigger SourceName="Popup" Property="IsOpen" Value="True">
              <Setter TargetName="Toggle" Property="IsHitTestVisible" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Search in a log ============ -->
  <SolidColorBrush x:Key="SearchMatchBrush" Color="#FFE7A3"/>
  <SolidColorBrush x:Key="SearchMarkerBrush" Color="#E0A800"/>
  <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#FDE7E9"/>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <!-- The query box frame in the log toolbar; red while the regex is invalid (Tag = True) -->
  <Style x:Key="SearchBoxFrame" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="6,0,2,0"/>
    <Setter Property="Height" Value="30"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="#B3B3B3"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      </Trigger>
      <Trigger Property="Tag" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="Background" Value="{StaticResource ErrorSubtleBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Borderless text box inside SearchBoxFrame; Tag is the placeholder -->
  <Style x:Key="SearchBoxTextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid Background="Transparent">
            <TextBlock x:Name="Placeholder"
                       Text="{TemplateBinding Tag}"
                       Padding="2,0,0,0"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>
            <ScrollViewer x:Name="PART_ContentHost"
                          VerticalAlignment="Center"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Small option toggle inside the query box: ".*", "Aa" -->
  <Style x:Key="SearchOptionToggle" TargetType="ToggleButton" BasedOn="{StaticResource OptionToggle}">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Focusable" Value="False"/>
  </Style>

  <!-- Compact glyph button inside the query box and in the results header -->
  <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Results header: glyph + text action, e.g. "Copy all" -->
  <Style x:Key="PanelActionButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    <Setter Property="Padding" Value="8,4,10,4"/>
    <Setter Property="Margin" Value="2,0,0,0"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PanelActionGlyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- A row of the search results: no theme chrome, accent-subtle selection -->
  <Style x:Key="SearchResultItem" TargetType="ListViewItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="Bd" Background="Transparent" Padding="0,2,0,2">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>