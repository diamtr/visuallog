<UserControl x:Class="VisualLog.Desktop.LogManager.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:root="clr-namespace:VisualLog.Desktop"
             xmlns:logmgr="clr-namespace:VisualLog.Desktop.LogManager"
             xmlns:search="clr-namespace:VisualLog.Desktop.Search"
             xmlns:ctl="clr-namespace:VisualLog.Desktop.Controls"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             DataContextChanged="LogView_DataContextChanged">

  <UserControl.Resources>
    <ResourceDictionary>

      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <root:VisibilityBoolConverter x:Key="VisibilityBoolConverter"/>
      <root:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>

      <DataTemplate DataType="{x:Type logmgr:SearchViewModel}">
        <logmgr:SearchView/>
      </DataTemplate>

    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ShowSearchPanelCommand}"/>
    <KeyBinding Gesture="F3" Command="{Binding SearchViewModel.NextCommand}"/>
    <KeyBinding Gesture="Shift+F3" Command="{Binding SearchViewModel.PreviousCommand}"/>
    <!-- Line details: previous / next line, by the search results if there are any -->
    <KeyBinding Gesture="Alt+Up" Command="{Binding Details.PreviousCommand}"/>
    <KeyBinding Gesture="Alt+Down" Command="{Binding Details.NextCommand}"/>
  </UserControl.InputBindings>

  <Grid>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,6,10,6"
            TextBlock.FontFamily="{StaticResource UiFont}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <logmgr:SearchBoxView Grid.Column="0"
                              x:Name="SearchBox"
                              DataContext="{Binding SearchViewModel}"/>

        <ToggleButton Grid.Column="2"
                      x:Name="FollowTailCheckBox"
                      IsChecked="{Binding State.FollowTail}"
                      Checked="FollowTailCheckBox_Checked"
                      ToolTip="Keep scrolling to new lines"
                      Style="{StaticResource ToolbarToggleButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74B;" Style="{StaticResource ToolbarGlyph}"/>
            <TextBlock Text="Follow tail" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>

        <Border Grid.Column="3"
                Width="1" Height="20"
                Margin="8,0,8,0"
                Background="{StaticResource CardBorderBrush}"/>

        <!-- Full path; click opens the folder in Explorer -->
        <Button Grid.Column="4"
                HorizontalAlignment="Left"
                Command="{Binding OpenInExplorerCommand}"
                ToolTip="Open containing folder"
                Style="{StaticResource SubtleButton}"
                Foreground="{StaticResource TextSecondaryBrush}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE838;" Style="{StaticResource ToolbarGlyph}" FontSize="13"/>
            <TextBlock Text="{Binding LogPath}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
          </DockPanel>
        </Button>

        <ComboBox Grid.Column="5"
                  ItemsSource="{Binding Encodings}"
                  SelectedItem="{Binding SelectedEncoding}"
                  ToolTip="Encoding"
                  Style="{StaticResource ToolbarComboBox}"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- The log with the search results under it; details of a line beside them -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="200"/>
        <ColumnDefinition x:Name="DetailsSplitterColumn" Width="0"/>
        <ColumnDefinition x:Name="DetailsPanelColumn" Width="0"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" x:Name="LogAndSearchGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="80"/>
          <RowDefinition x:Name="SearchSplitterRow" Height="0"/>
          <RowDefinition x:Name="SearchPanelRow" Height="0"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <!-- The log as plain read-only text: one document, so the selection may span lines and
               the horizontal scroll moves all the lines together. Filled by code-behind. -->
          <ae:TextEditor x:Name="LogEditor"
                         IsReadOnly="True"
                         WordWrap="False"
                         FontFamily="{StaticResource LogFont}"
                         FontSize="{StaticResource LogFontSize}"
                         Background="{StaticResource CardBrush}"
                         Foreground="{StaticResource LogTextBrush}"
                         TextOptions.TextFormattingMode="Display"
                         TextOptions.TextRenderingMode="ClearType"
                         LineNumbersForeground="{StaticResource TextTertiaryBrush}"
                         ShowLineNumbers="{Binding Display.ShowLineNumbers, FallbackValue=False}"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Padding="6,2,0,0"
                         Loaded="LogEditor_Loaded"
                         PreviewKeyDown="LogEditor_PreviewKeyDown"
                         MouseDoubleClick="LogEditor_MouseDoubleClick"
                         ContextMenuOpening="LogEditor_ContextMenuOpening">
            <ae:TextEditor.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="ShowDetailsMenuItem" Header="Show details" InputGestureText="Double-click" Click="ShowDetailsMenuItem_Click"/>
                <Separator/>
                <MenuItem x:Name="CopyMenuItem" Header="Copy" InputGestureText="Ctrl+C" Click="CopyMenuItem_Click"/>
                <MenuItem x:Name="SearchSelectionMenuItem" InputGestureText="Ctrl+F" Click="SearchSelectionMenuItem_Click">
                  <MenuItem.Header>
                    <!-- TextBlock: an underscore in the selected text is not an access key -->
                    <TextBlock x:Name="SearchSelectionMenuHeader" Text="Search"/>
                  </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="SelectAllMenuItem_Click"/>
              </ContextMenu>
            </ae:TextEditor.ContextMenu>
          </ae:TextEditor>

          <!-- Search results marked along the vertical scrollbar of the log; placed by code-behind -->
          <ctl:ScrollMarkersBar x:Name="SearchMarkers"
                                HorizontalAlignment="Right"
                                LineNumbers="{Binding SearchViewModel.MatchLineNumbers}"
                                TotalLines="{Binding LogMessages.Count}"
                                CurrentLineNumber="{Binding SearchViewModel.CurrentLineNumber}"
                                MarkerBrush="{StaticResource SearchMarkerBrush}"
                                CurrentMarkerBrush="{StaticResource AccentBrush}"/>
        </Grid>

        <GridSplitter Grid.Row="1"
                      x:Name="SearchSplitter"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource DividerBrush}"
                      Cursor="SizeNS"
                      Focusable="False"
                      DragCompleted="SearchSplitter_DragCompleted"/>

        <ContentControl Grid.Row="2"
                        x:Name="SearchPaneContentControl"
                        Focusable="False"
                        Content="{Binding SearchViewModel}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>

      </Grid>

      <GridSplitter Grid.Column="1"
                    x:Name="DetailsSplitter"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    Background="{StaticResource DividerBrush}"
                    Cursor="SizeWE"
                    Focusable="False"
                    Visibility="Collapsed"
                    DragCompleted="DetailsSplitter_DragCompleted"/>

      <logmgr:MessageDetailsView Grid.Column="2"
                                 x:Name="DetailsPane"
                                 DataContext="{Binding Details}"
                                 Visibility="Collapsed"/>
    </Grid>

  </Grid>

</UserControl>
