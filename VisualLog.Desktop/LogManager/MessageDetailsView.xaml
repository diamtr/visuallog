<UserControl x:Class="VisualLog.Desktop.LogManager.MessageDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:root="clr-namespace:VisualLog.Desktop"
             xmlns:logmgr="clr-namespace:VisualLog.Desktop.LogManager"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="420"
             d:DataContext="{d:DesignInstance Type=logmgr:MessageDetailsViewModel}">
  <!-- Details of one line of the log, beside the log. The look is picked by the type of the details. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <root:VisibilityBoolConverter x:Key="VisibilityBoolConverter"/>

      <SolidColorBrush x:Key="JsonNameBrush" Color="#7A3E9D"/>
      <SolidColorBrush x:Key="JsonStringBrush" Color="#1B6B3A"/>
      <SolidColorBrush x:Key="JsonNumberBrush" Color="#1750EB"/>
      <SolidColorBrush x:Key="JsonKeywordBrush" Color="#0033B3"/>

      <!-- Menu of the read-only text: the default one of TextBox also offers Cut and Paste -->
      <ContextMenu x:Key="DetailsTextContextMenu" x:Shared="False">
        <MenuItem Header="Copy" InputGestureText="Ctrl+C"
                  Command="ApplicationCommands.Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <Separator/>
        <MenuItem Header="Select all" InputGestureText="Ctrl+A"
                  Command="ApplicationCommands.SelectAll"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
      </ContextMenu>

      <!-- Read-only text of the line, wrapped by words, selectable -->
      <Style x:Key="DetailsText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6,8,6"/>
        <Setter Property="FontFamily" Value="{StaticResource LogFont}"/>
        <Setter Property="FontSize" Value="{StaticResource LogFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource LogTextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
      </Style>

      <!-- Tree / Text switch of JSON lines -->
      <Style x:Key="DetailsModeButton" TargetType="RadioButton" BasedOn="{StaticResource ToolbarToggleButton}">
        <Setter Property="Padding" Value="10,3,10,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      </Style>

      <!-- Chevron of a tree node -->
      <Style x:Key="DetailsExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent">
                <TextBlock x:Name="Glyph"
                           Text="&#xE76C;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="9"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Not shared: every node gets its own menu, so the menu gets the node as its DataContext
           (one menu set on many elements loses it, and its commands are never bound) -->
      <ContextMenu x:Key="NodeContextMenu" x:Shared="False">
        <MenuItem Header="Copy selected text" InputGestureText="Ctrl+C"
                  Command="ApplicationCommands.Copy"
                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        <Separator/>
        <MenuItem Header="Copy value" Command="{Binding CopyValueCommand}"/>
        <MenuItem Command="{Binding CopyNameCommand}">
          <MenuItem.Header>
            <!-- TextBlock: an underscore in the name is not an access key -->
            <TextBlock Text="{Binding Name, StringFormat='Copy name “{0}”'}"/>
          </MenuItem.Header>
        </MenuItem>
      </ContextMenu>

      <!-- A node of the tree: the header takes the width left after the indent, so long values wrap -->
      <Style x:Key="DetailsTreeItem" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TreeViewItem">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ToggleButton x:Name="Expander"
                              Style="{StaticResource DetailsExpander}"
                              ClickMode="Press"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Border x:Name="Bd"
                        Grid.Column="1"
                        Background="Transparent"
                        CornerRadius="3"
                        Padding="4,1,4,1">
                  <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                </Border>
                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="False">
                  <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="HasItems" Value="False">
                  <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Value of a tree node: looks like text, but a part of it can be selected and copied -->
      <Style x:Key="DetailsValue" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="-2,0,0,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource LogTextBrush}"/>
      </Style>

      <!-- A line that is not JSON: its text, wrapped -->
      <DataTemplate DataType="{x:Type logmgr:TextMessageDetailsViewModel}">
        <TextBox Style="{StaticResource DetailsText}" Text="{Binding RawText, Mode=OneWay}"
                 ContextMenu="{StaticResource DetailsTextContextMenu}"/>
      </DataTemplate>

      <!-- A JSON object line: tree of the fields or indented JSON -->
      <DataTemplate DataType="{x:Type logmgr:JsonMessageDetailsViewModel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,8,4">
            <RadioButton Content="Tree" IsChecked="{Binding IsTreeView}" Style="{StaticResource DetailsModeButton}"
                         ToolTip="Fields of the object; nested objects expand"/>
            <RadioButton Content="Text" IsChecked="{Binding IsTextView}" Style="{StaticResource DetailsModeButton}"
                         ToolTip="The object as indented JSON"/>
          </StackPanel>

          <TreeView Grid.Row="1"
                    x:Name="FieldsTree"
                    ItemsSource="{Binding Fields}"
                    BorderThickness="0"
                    Background="Transparent"
                    Padding="4,0,8,6"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    FontFamily="{StaticResource LogFont}"
                    FontSize="{StaticResource LogFontSize}"
                    TextOptions.TextFormattingMode="Display"
                    Visibility="{Binding IsTreeView, Converter={StaticResource VisibilityBoolConverter}}"
                    PreviewKeyDown="FieldsTree_PreviewKeyDown">
            <TreeView.Resources>
              <Style TargetType="TreeViewItem" BasedOn="{StaticResource DetailsTreeItem}"/>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate DataType="{x:Type logmgr:JsonNodeViewModel}" ItemsSource="{Binding Children}">
                <DockPanel Background="Transparent" ContextMenu="{StaticResource NodeContextMenu}">
                  <TextBlock DockPanel.Dock="Left"
                             Text="{Binding Name, StringFormat={}{0}:}"
                             Foreground="{StaticResource JsonNameBrush}"
                             Margin="0,0,8,0"/>
                  <TextBox x:Name="ValueText"
                           Style="{StaticResource DetailsValue}"
                           Text="{Binding Value, Mode=OneWay}"
                           ContextMenu="{StaticResource NodeContextMenu}"/>
                </DockPanel>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="String">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource JsonStringBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Number">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource JsonNumberBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Boolean">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource JsonKeywordBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Null">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Object">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                    <Setter TargetName="ValueText" Property="FontFamily" Value="{StaticResource UiFont}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Kind}" Value="Array">
                    <Setter TargetName="ValueText" Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                    <Setter TargetName="ValueText" Property="FontFamily" Value="{StaticResource UiFont}"/>
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <TextBox Grid.Row="1"
                   Style="{StaticResource DetailsText}"
                   Text="{Binding IndentedText, Mode=OneWay}"
                   ContextMenu="{StaticResource DetailsTextContextMenu}"
                   Visibility="{Binding IsTextView, Converter={StaticResource VisibilityBoolConverter}}"/>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Gesture="Esc" Command="{Binding CloseCommand}"/>
  </UserControl.InputBindings>

  <Grid Background="{StaticResource CardBrush}" TextBlock.FontFamily="{StaticResource UiFont}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header: the line, copy, close -->
    <Border Grid.Row="0"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,4,6,4">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource PanelActionButton}" Command="{Binding CopyCommand}" ToolTip="Copy the line as shown">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8C8;" Style="{StaticResource PanelActionGlyph}"/>
              <TextBlock Text="Copy"/>
            </StackPanel>
          </Button>
          <Border Width="1" Height="18" Margin="6,0,4,0" Background="{StaticResource CardBorderBrush}"/>
          <Button Style="{StaticResource SmallIconButton}"
                  Content="&#xE711;"
                  FontSize="10"
                  ToolTip="Close panel (Esc)"
                  Command="{Binding CloseCommand}"/>
        </StackPanel>

        <!-- By the search results if there are any, otherwise by all the lines -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource SmallIconButton}"
                  Content="&#xE70E;"
                  FontSize="11"
                  Margin="-8,0,0,0"
                  ToolTip="Previous line; of the search results if there are any (Alt+Up)"
                  Command="{Binding PreviousCommand}"/>
          <Button Style="{StaticResource SmallIconButton}"
                  Content="&#xE70D;"
                  FontSize="11"
                  ToolTip="Next line; of the search results if there are any (Alt+Down)"
                  Command="{Binding NextCommand}"/>
          <TextBlock Text="{Binding LineNumber, StringFormat='Line {0}'}"
                     Margin="8,0,0,0"
                     FontSize="12.5"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl Grid.Row="1"
                    Content="{Binding}"
                    Focusable="False"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"/>
  </Grid>
</UserControl>
