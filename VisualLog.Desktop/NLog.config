<?xml version="1.0" encoding="utf-8" ?>
<!-- Application diagnostics: log/VisualLog.<date>.log next to the executable, 14 days are kept -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="false">

  <variable name="logs-path" value="${basedir}/log" />

  <targets>
    <!-- Synchronous on purpose: on a crash nothing must stay in a queue -->
    <target name="file" xsi:type="File"
            fileName="${logs-path}/VisualLog.${shortdate}.log"
            maxArchiveDays="14"
            keepFileOpen="false"
            encoding="utf-8"
            header="${longdate} ======== VisualLog ${assembly-version} started, pid ${processid} ========"
            layout="${longdate} ${level:uppercase=true:padding=-5} [${threadid:padding=2}] ${logger:shortName=true}: ${message}${onexception:${newline}${exception:format=tostring}}" />

    <target name="debugger" xsi:type="Debugger"
            layout="${time} ${level:uppercase=true:padding=-5} ${logger:shortName=true}: ${message}${onexception: ${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- WPF binding errors are noisy: warnings only -->
    <logger name="WpfBinding" minlevel="Warn" writeTo="file,debugger" final="true" />
    <logger name="*" minlevel="Debug" writeTo="file" />
    <logger name="*" minlevel="Debug" writeTo="debugger" />
  </rules>
</nlog>
