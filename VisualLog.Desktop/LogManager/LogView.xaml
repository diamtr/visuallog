<UserControl x:Class="VisualLog.Desktop.LogManager.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:root="clr-namespace:VisualLog.Desktop"
             xmlns:logmgr="clr-namespace:VisualLog.Desktop.LogManager"
             xmlns:search="clr-namespace:VisualLog.Desktop.Search"
             xmlns:ctl="clr-namespace:VisualLog.Desktop.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
             DataContextChanged="LogView_DataContextChanged">

  <UserControl.Resources>
    <ResourceDictionary>

      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <root:VisibilityBoolConverter x:Key="VisibilityBoolConverter"/>
      <root:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>

      <DataTemplate DataType="{x:Type logmgr:MessageInlineViewModel}">
        <logmgr:MessageInlineView />
      </DataTemplate>

      <DataTemplate DataType="{x:Type logmgr:SelectedMessagesViewModel}">
        <logmgr:SelectedMessagesView />
      </DataTemplate>

      <DataTemplate DataType="{x:Type logmgr:SearchViewModel}">
        <logmgr:SearchView/>
      </DataTemplate>

    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Gesture="Ctrl+F" Command="{Binding ShowSearchPanelCommand}"/>
    <KeyBinding Gesture="F3" Command="{Binding SearchViewModel.NextCommand}"/>
    <KeyBinding Gesture="Shift+F3" Command="{Binding SearchViewModel.PreviousCommand}"/>
  </UserControl.InputBindings>

  <Grid>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Grid.Row="0"
            Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,6,10,6"
            TextBlock.FontFamily="{StaticResource UiFont}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <logmgr:SearchBoxView Grid.Column="0"
                              x:Name="SearchBox"
                              DataContext="{Binding SearchViewModel}"/>

        <ToggleButton Grid.Column="1"
                      x:Name="ShowSelectedMessagesPanelButton"
                      IsChecked="{Binding State.ShowSelectedMessagesPanel}"
                      Command="{Binding ShowSelectedLinesCommand}"
                      ToolTip="Show selected lines"
                      Style="{StaticResource ToolbarToggleButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE762;" Style="{StaticResource ToolbarGlyph}"/>
            <TextBlock Text="Selected lines" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>

        <ToggleButton Grid.Column="2"
                      x:Name="FollowTailCheckBox"
                      IsChecked="{Binding State.FollowTail}"
                      Checked="FollowTailCheckBox_Checked"
                      ToolTip="Keep scrolling to new lines"
                      Style="{StaticResource ToolbarToggleButton}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74B;" Style="{StaticResource ToolbarGlyph}"/>
            <TextBlock Text="Follow tail" VerticalAlignment="Center"/>
          </StackPanel>
        </ToggleButton>

        <Border Grid.Column="3"
                Width="1" Height="20"
                Margin="8,0,8,0"
                Background="{StaticResource CardBorderBrush}"/>

        <!-- Full path; click opens the folder in Explorer -->
        <Button Grid.Column="4"
                HorizontalAlignment="Left"
                Command="{Binding OpenInExplorerCommand}"
                ToolTip="Open containing folder"
                Style="{StaticResource SubtleButton}"
                Foreground="{StaticResource TextSecondaryBrush}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE838;" Style="{StaticResource ToolbarGlyph}" FontSize="13"/>
            <TextBlock Text="{Binding LogPath}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
          </DockPanel>
        </Button>

        <ComboBox Grid.Column="5"
                  ItemsSource="{Binding Encodings}"
                  SelectedItem="{Binding SelectedEncoding}"
                  ToolTip="Encoding"
                  Style="{StaticResource ToolbarComboBox}"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center"/>
      </Grid>
    </Border>
    
    <Grid Grid.Row="2" x:Name="LogAndSelectedMessagesGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="80"/>
        <RowDefinition x:Name="SearchSplitterRow" Height="0"/>
        <RowDefinition x:Name="SearchPanelRow" Height="0"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <ListView x:Name="MessagesListView"
                  ItemsSource="{Binding LogMessages}"
                  SelectedItem="{Binding SelectedLogMessage}"
                  SelectionMode="Extended"
                  BorderThickness="0,0,0,0"
                  SelectionChanged="MessagesListView_SelectionChanged"
                  Loaded="MessagesListView_Loaded"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.CacheLength="2"
                  VirtualizingPanel.CacheLengthUnit="Page">
          <ListView.ItemContainerStyle>
            <!-- Highlight background goes on the row container: the theme's selection/hover
                 look is drawn over it, so selected highlighted lines still look selected.
                 No BasedOn: the theme style (template, selection) applies anyway, and a
                 StaticResource to {x:Type ListViewItem} can't be resolved here (crash on open). -->
            <Style TargetType="ListViewItem">
              <Setter Property="Background" Value="{Binding Highlight.Background}"/>
            </Style>
          </ListView.ItemContainerStyle>
        </ListView>

        <!-- Search results marked along the vertical scrollbar of the log; placed by code-behind -->
        <ctl:ScrollMarkersBar x:Name="SearchMarkers"
                              HorizontalAlignment="Right"
                              LineNumbers="{Binding SearchViewModel.MatchLineNumbers}"
                              TotalLines="{Binding LogMessages.Count}"
                              CurrentLineNumber="{Binding SearchViewModel.CurrentLineNumber}"
                              MarkerBrush="{StaticResource SearchMarkerBrush}"
                              CurrentMarkerBrush="{StaticResource AccentBrush}"/>
      </Grid>

      <GridSplitter Grid.Row="1"
                    x:Name="SearchSplitter"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext"
                    Background="{StaticResource DividerBrush}"
                    Cursor="SizeNS"
                    Focusable="False"
                    DragCompleted="SearchSplitter_DragCompleted"/>

      <ContentControl Grid.Row="2"
                      x:Name="SearchPaneContentControl"
                      Focusable="False"
                      Content="{Binding SearchViewModel}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"/>

      <Border Grid.RowSpan="3"
              Visibility="{Binding ElementName=ShowSelectedMessagesPanelButton, Path=IsChecked, Converter={StaticResource VisibilityBoolConverter}}"
              Background="{StaticResource PanelBackgroundBrush}"
              Opacity="0.5"/>

      <Border Grid.RowSpan="3"
              Visibility="{Binding ElementName=ShowSelectedMessagesPanelButton, Path=IsChecked, Converter={StaticResource VisibilityBoolConverter}}"
              Background="Transparent"
              Padding="50,20,50,10">
        <ContentControl Content="{Binding SelectedMessagesViewModel}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"/>
      </Border>

    </Grid>

  </Grid>

</UserControl>
